# Non-secret infrastructure defaults for the Claude Cloud dev-state tooling.
# Every value can be overridden by an environment variable of the same name.
# NEVER put passwords, tokens, keys or R2 credentials in this file.

# Bench and users
BENCH_DIR=/home/frappe/frappe-bench
FRAPPE_USER=frappe
FRAPPE_BRANCH=version-16
PYTHON_VERSION=3.14
NODE_MAJOR=24
NODE_DIR=/opt/node24

# Where snapshots, staging and logs live (outside every Git repository)
DEV_STATE_DIR=/home/frappe/.dev-state
# Per-session infrastructure secrets (DB root passwords). Created by bootstrap, never snapshotted.
DEV_SECRETS_DIR=/home/frappe/.dev-secrets

# PostgreSQL (local cluster, loopback only)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_CLUSTER_VERSION=16
PG_CLUSTER_NAME=main
PG_ROOT_USER=frappe_dev_root

# MariaDB (Docker, published on loopback only)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_ROOT_USER=root
MARIADB_CONTAINER=frappe-mariadb
MARIADB_IMAGE=mariadb:11.8
MARIADB_VOLUME=frappe-mariadb-data
# Source address MariaDB sees for host connections through Docker's bridge
MARIADB_USER_HOST_SCOPE=172.17.0.1

# Storage backend: local | r2   (r2 needs R2_* variables from the environment, never from here)
DEV_STATE_BACKEND=local
R2_PREFIX=frappe-dev-state
DEV_STATE_R2_VENV=/opt/dev-state-venv

# Optional development services (started only with explicit bootstrap flags)
# The mock lives in this repository: dev/wa_admin_mock (see its README.md)
WA_ADMIN_MOCK_DIR=/home/user/whatsapp_next/dev/wa_admin_mock
WA_ADMIN_MOCK_PORT=18080
DEV_WEB_PORT=8000

# Safety: substrings that must never appear in a development site's configuration
PRODUCTION_URL_MARKERS=wa-admin.sanad.digital
