   "options": "Daily\nWeekly\nMonthly\nQuarterly\nYearly",
   "reqd": 1,
   "default": "Daily",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "day_of_week",
   "label": "Day of Week",
   "fieldtype": "Select",
   "options": "Monday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday",
