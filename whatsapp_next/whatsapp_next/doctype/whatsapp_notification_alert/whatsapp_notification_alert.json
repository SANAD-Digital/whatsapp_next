   "label": "Schedule"
  },
  {
   "fieldname": "alert_name",
   "label": "Name",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "enabled",
   "label": "Enabled",
   "fieldtype": "Check",
   "default": "1",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "periodicity",
   "label": "Periodicity",
