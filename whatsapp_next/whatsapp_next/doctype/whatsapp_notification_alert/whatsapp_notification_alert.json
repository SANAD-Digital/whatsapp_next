  {
   "fieldname": "dynamic_filters_json",
   "label": "Dynamic Filters",
   "fieldtype": "Code",
   "options": "JSON",
   "depends_on": "eval:doc.content_type==\"Report\"",
   "description": "Report filters that follow the date, e.g. {\"from_date\": \"month_start\", \"to_date\": \"today\"}."
  },
  {
   "fieldname": "body_section",
   "fieldtype": "Section Break",
   "label": "Body"
