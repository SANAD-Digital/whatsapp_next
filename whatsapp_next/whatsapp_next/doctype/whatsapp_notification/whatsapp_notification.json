   "options": "DocType",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_15",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "event",
   "label": "Send Alert On",
   "fieldtype": "Select",
   "options": "New\nSave\nSubmit\nCancel\nDays Before\nDays After\nMinutes Before\nMinutes After\nValue Change\nMethod",
   "reqd": 1,
   "in_standard_filter": 1,
   "description": "Save = every document; Submit = on submit; Days After + date_changed = overdue; Submit + condition = amount threshold"
  },
  {
   "fieldname": "date_changed",
   "label": "Reference Date",
   "fieldtype": "Select",
   "depends_on": "eval:[\"Days Before\",\"Days After\"].includes(doc.event)",
   "description": "Options set by JS from Date fields of document_type"
  },
  {
   "fieldname": "days_in_advance",
   "label": "Days Before or After",
   "fieldtype": "Int",
   "default": "0",
   "depends_on": "eval:[\"Days Before\",\"Days After\"].includes(doc.event)"
  },
  {
   "fieldname": "datetime_changed",
   "label": "Reference Datetime",
   "fieldtype": "Select",
   "depends_on": "eval:[\"Minutes Before\",\"Minutes After\"].includes(doc.event)"
  },
  {
   "fieldname": "minutes_offset",
   "label": "Minutes Before or After",
   "fieldtype": "Int",
   "default": "0",
   "depends_on": "eval:[\"Minutes Before\",\"Minutes After\"].includes(doc.event)"
  },
  {
   "fieldname": "value_changed",
   "label": "Value Changed",
   "fieldtype": "Select",
   "depends_on": "eval:doc.event==\"Value Change\"",
   "description": "Fieldname"
  },
  {
   "fieldname": "method",
   "label": "Method",
   "fieldtype": "Data",
   "depends_on": "eval:doc.event==\"Method\"",
   "description": "Doc event name (e.g. on_update_after_submit), not a dotted path"
  },
  {
   "fieldname": "condition_section",
