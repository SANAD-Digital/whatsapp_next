 "fields": [
  {
   "fieldname": "message_type",
   "label": "Message Type",
   "fieldtype": "Select",
   "options": "Text\nDocument\nImage\nVideo\nAudio\nSticker\nLocation\nPoll",
   "reqd": 1,
   "default": "Text",
   "in_list_view": 1,
   "description": "Same vocabulary as Outbound"
  },
  {
   "fieldname": "template",
   "label": "Template",
   "fieldtype": "Link",
   "options": "WhatsApp Template",
   "in_list_view": 1,
   "description": "Choosing copies body/attachment/print_format into the row; later template edits do not propagate"
  },
  {
   "fieldname": "body",
   "label": "Body",
   "fieldtype": "Text",
   "in_list_view": 1,
   "depends_on": "eval:doc.message_type!=\"Location\"",
   "description": "Jinja; context = recipient row (display_name, phone, contact doc)"
  },
  {
   "fieldname": "caption",
   "label": "Caption",
   "fieldtype": "Small Text",
   "depends_on": "eval:[\"Document\",\"Image\",\"Video\"].includes(doc.message_type)"
  },
  {
   "fieldname": "attachment",
   "label": "Attachment",
   "fieldtype": "Attach",
   "depends_on": "eval:[\"Document\",\"Image\",\"Video\",\"Audio\",\"Sticker\"].includes(doc.message_type)",
   "description": "Same file for every recipient"
  },
  {
   "fieldname": "print_format",
   "label": "Print Format",
   "fieldtype": "Link",
   "options": "Print Format",
   "depends_on": "eval:doc.message_type==\"Document\"",
   "description": "Per-recipient PDF; requires contact + source_doctype/source_name on the recipient row"
  },
  {
   "fieldname": "file_name_template",
   "label": "File Name Template",
   "fieldtype": "Data",
   "depends_on": "eval:doc.message_type==\"Document\"",
   "description": "Jinja"
  },
  {
   "fieldname": "poll_question",
   "label": "Poll Question",
   "fieldtype": "Data",
   "depends_on": "eval:doc.message_type==\"Poll\""
  },
  {
   "fieldname": "poll_options",
   "label": "Poll Options",
   "fieldtype": "JSON",
   "depends_on": "eval:doc.message_type==\"Poll\""
  },
  {
   "fieldname": "poll_allow_multiple",
   "label": "Allow Multiple Answers",
   "fieldtype": "Check",
   "default": "0",
   "depends_on": "eval:doc.message_type==\"Poll\""
  },
  {
   "fieldname": "delay_seconds",
   "label": "Delay after Previous (s)",
   "fieldtype": "Int",
   "default": "0",
   "in_list_view": 1,
   "description": "Gap between consecutive messages to the same recipient"
  }
